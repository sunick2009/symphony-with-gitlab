# Stage 2 disposable GitLab staging validation.
# Copy this file to `.env` and fill in values locally. Do not commit `.env`.

# GitLab instance URL.
GITLAB_ENDPOINT=https://gitlab.com

# Numeric disposable staging project ID. Optional when GITLAB_PROJECT_SLUG is set.
GITLAB_PROJECT_ID=

# Project path, for example `group-or-namespace/symphony-stage2`.
GITLAB_PROJECT_SLUG=

# Project-scoped bot token for the disposable staging project.
# Required scope: api.
# Forbidden: write_repository and production project access.
GITLAB_API_TOKEN=

# Webhook secret token. Generate with: openssl rand -hex 32
GITLAB_WEBHOOK_SECRET=

# Public URL that GitLab can reach.
# It must route to Symphony at /api/v1/gitlab/webhook.
GITLAB_WEBHOOK_PUBLIC_URL=

# Safety gate. Keep this as `yes` only for a disposable staging project.
STAGE2_CONFIRM_DISPOSABLE_PROJECT=yes

# Optional run identifier used in synthetic issue titles.
STAGE2_RUN_ID=

# Optional local runtime/evidence locations.
STAGE2_RUNTIME_DIR=/tmp/symphony-stage2
STAGE2_EVIDENCE_DIR=/tmp/symphony-stage2/evidence
STAGE2_WORKFLOW_FILE=/tmp/symphony-stage2/WORKFLOW.stage2.md
SYMPHONY_STAGE2_AGENT_TRACE=/tmp/symphony-stage2/agent-env.trace
